<script>
$(function(){
    var initReady = setInterval(function(){
        if ('san' in window) {
            clearInterval(initReady);
            doJumptoByDatafor();
        }
    }, 10);

    var readyInterval = setInterval(function(){
        if(DOTABS){
            clearInterval(readyInterval);
            //指定默认tab页，如/chinese/home/index.html?tab=2
            var tab = getQueryStr('tab');
            if(!tab){
                tab = 1;
            }

            $('#tabs-member-fx').sanTabs({
                layout: 'table',
                defaultItem: tab,
                equalWidth: false,
                inject:true,
                type:"mix",
                mediaListening: true,
                onDone:function($li){
                    var index=$li.attr('data-tabs-index');
                    $(this).find('div[data-url]:not(.san-datasheet)').each(function(){
                        $(this).sanJumpto();
                        // $(this).parent().siblings('div[data-show="toggle"]').children('div[data-url]').children().remove();
                        // $(this).parent().siblings('div[data-show="toggle"]').children('div[data-url]').siblings().remove();
                    })
                }
            });
        }
    },10);
})
</script>

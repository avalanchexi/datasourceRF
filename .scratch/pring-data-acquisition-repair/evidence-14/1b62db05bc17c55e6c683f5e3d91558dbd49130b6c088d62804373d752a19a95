            $("#customLegend").empty(); //clear the legend before updating

            var startDate = $("#startDate").datepicker("getDate"); //use the current day or last business date
            if (!startDate) {
                startDate = new Date();
                startDate.setHours(0, 0, 0, 0);
            }
            if (startDate.getDay() == 6) { // Saturday
                addDays(startDate, -1);
            }
            if (startDate.getDay() == 0) { // Sunday
                addDays(startDate, -2);
            }

            var endDate = $("#endDate").datepicker("getDate"); //use the current day or last business date
            if (!endDate) {
                endDate = new Date();
                endDate.setHours(0, 0, 0, 0);
            }
            if (endDate.getDay() == 6) { // Saturday
                addDays(endDate, -1);
            }
            if (endDate.getDay() == 0) { // Sunday
                addDays(endDate, -2);
            }

            var options = {
                chart: {
                    plotBackgroundColor: null,
                    plotBorderWidth: null,
                    plotShadow: false,
                    backgroundColor: "#edf2f7",
                    type: 'pie',
                    events: {
                        load: function () {
                            var legend = $('#customLegend');
                            var wrapperStart = '<div class="flex flex-wrap w-1/2 lg:w-1/3 p-2">'
                                + '<div class="inline-flex w-full items-center">'
                                + '<svg height="8" width="8" class="inline-flex mr-3">';
                            if (!this.series[0] || !this.series[0].data.length) {
                                $("#chartParent").hide();
                            } else {
                                setTimeout(function () {
                                    $("#chartParent").show();
                                }, 100)
                            }
                            $.each(this.series[0].data, function (j, data) {
                                legend.append(wrapperStart
                                    + '<circle cx="4" cy="4" r="4" stroke="none" stroke-width="0" fill="'
                                    + data.color
                                    + '" /></svg><p class="inline-flex font-semibold uppercase" style="font-size: 13px; color: '
                                    + data.color
                                    + ';">'
                                    + data.name
                                    + '</p></div>' + '<div class="block w-full text-3xl heading">'
                                    + '<data>' + data.y.toFixed(2) + '%</data>'
                                    + '</div>'
                                );
                            });

                        }
                    }
                },
                credits: {
                    enabled: false
                },
                title: {
                    text: undefined
                },
                tooltip: {
                    //pointFormat: '{series.name}: <b>{point.percentage:.1f}%</b>'
                    pointFormatter: function () {
                        var value = Highcharts.numberFormat(this.y, 2);
                        return 'Holdings: <b>' + value + '%</b>';
                    }
                },
                accessibility: {
                    point: {
                        valueSuffix: '%'
                    }
                },
                plotOptions: {
                    pie: {
                        allowPointSelect: true,
                        cursor: 'pointer',
                        float: true,
                        dataLabels: {
                            enabled: false,
                            format: '<b>{point.name}</b>: {point.percentage:.1f} %'

                        },
                        colors: ["#0092bc", "#cc4db3", "#6743D1", "#ffd433", "#ff5b65", "#9c75f2", "#faa04d", "#1ac9bd", "#8d6e63", "#3dcf60", "#3667e4"]
                    }
                },
                series: [{
                    name: 'Holdings',
                    colorByPoint: true,
                    data: function () {
                        return dataList.toString();
                    }
                }],

            };

            var seriesData = [];
            options.series[0].data = [];
            $.ajax({
                url: "/Index/BreakdownData",
                type: "POST",
                data: { id: $("#symbol").text(), startDate: startDate.toISONonUtcString(), endDate: endDate.toISONonUtcString() },
                dataType: "html",
                success: function (jsonData) {
                    var dataFromService = JSON.parse(jsonData);
                    for (i = dataFromService.length - 1; i > 0; i--) {
                        if (dataFromService[i].length > 0) {
                            var item = dataFromService[i][dataFromService[i].length - 1].ColumnInfo;
                            for (var key of Object.keys(item)) {
                                var obj = {};
                                obj.name = key;
                                obj.y = item[key];
                                seriesData.push(obj);
                            }
                            break;
                        }
                    }
                    options.series[0].data = seriesData;
                    var chart = new Highcharts.Chart('chartcontainer', options);
                },
                error: function (jsonData, status, xhr) {
                    return;
                }
            });


        }

        $(document).ready(updateChart());

    </script>
    <script src="/Scripts/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="/Scripts/Breakdown.js?v=2.0.0.33192" type="text/javascript"></script>

</body>
</html>

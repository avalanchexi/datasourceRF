<script type="text/javascript">
$(function(){
    $('#pr-dly-bltn-search-date').datepicker({
        onSelect: function(dateText, inst){
            $('#title-pr-dly-bltn-date').text(dateText);
            doSearchPr();
        }
    });

    $('#pr-dly-bltn-mark').sanDatasheet({
        url: DURL+'currency/pr-dly-bltn-mark.json',
        dataHandler: function(data){
        	$('#title-pr-dly-bltn-date').text(data['data']['lastDate']);
        	$('#pr-dly-bltn-search-date').datepicker('option', 'maxDate', data.data.endDate);
			$('#pr-dly-bltn-search-date').datepicker('option', 'minDate', data.data.startDate);
			$('#pr-dly-bltn-search-date').val(data.data.lastDate);
			$('#pr-excel').attr("href",DQSURL + "cm-u-dlrp/PrDlyBltnExcel?lang=cn&searchDate="+data.data.lastDate+"&publishedTime="+PR_PUBLISHED_TIME);
			var d = data['data']['updateDate'];
            var $sheet = this;
            return _example_dataFormatter($sheet, d, data['records']);
        },
		mediaListening: true,
		onMediaChange: function(){
			// 通过滚动条滚动，并固定首列
			if (MEDIA_CASE != 'XL') {
				var sheetSet = getsheetWidthCase($('#pr-dly-bltn-mark'), setSheetWidth($('#pr-dly-bltn-mark'))),
					rw = sheetSet.width,
					strCol = sheetSet.colHtml;
				$('#pr-dly-bltn-mark').find('colgroup').html(strCol);
			} else {
				$('#pr-dly-bltn-mark').find('colgroup').empty();
			}
			return {
				'XL': {
					fixedLayout: false
				},
				'default': {
					fixedLayout: true,
					fixedLayoutType: 'column',
					fixedBodyWidth: rw,
					fixedColNumber: 1
				}
			}
		}
    });
    
    $('#pr-dly-bltn-term').sanDatasheet({
        url: DURL+'currency/pr-dly-bltn-interbank-mark.json',
        dataHandler: function(data){
        	$('#title-pr-dly-bltn-date').text(data['data']['lastDate']);
        	$('#pr-dly-bltn-search-date').datepicker('option', 'maxDate', data.data.endDate);
			$('#pr-dly-bltn-search-date').datepicker('option', 'minDate', data.data.startDate);
			$('#pr-dly-bltn-search-date').val(data.data.lastDate);
			$('#pr-excel').attr("href",DQSURL + "cm-u-dlrp/PrDlyBltnExcel?lang=cn&searchDate="+data.data.lastDate+"&publishedTime="+PR_PUBLISHED_TIME);
            var $sheet = this;
            return _example_dataFormatter($sheet, data['data']['updateDate'], data['records']);
        },
        mediaListening: true,
        onMediaChange: function(){
        	// 通过滚动条滚动，并固定首列
			if (MEDIA_CASE != 'XL') {
				var sheetSet = getsheetWidthCase($('#pr-dly-bltn-term'), setSheetWidth($('#pr-dly-bltn-term'))),
					rw = sheetSet.width,
					strCol = sheetSet.colHtml;
				$('#pr-dly-bltn-term').find('colgroup').html(strCol);
			} else {
				$('#pr-dly-bltn-term').find('colgroup').empty();
			}
			return {
				'XL': {
					fixedLayout: false
				},
				'default': {
					fixedLayout: true,
					fixedLayoutType: 'column',
					fixedBodyWidth: rw,
					fixedColNumber: 1
				}
			}
        }
    });
	
	//备注
	notesSetup('#tips-ibl-dly-zyshgrb', 'notes-dly-zyshgrb', DURL+'note/note-2062.json');
});


function doSearchPr(){
	var searchDate = $('#pr-dly-bltn-search-date').val();
	prMarkList(searchDate);
	prTermList(searchDate);
}


function prMarkList(searchDate){	
	$.ajax({
		type: "POST",
		    async:false,
			url:BK_URL + 'cm-u-dlrp/PrDlyBltn',
			data:{
				lang : "cn",
				indexType : "markVOList",
				searchDate : searchDate,
				publishedTime : PR_PUBLISHED_TIME
			},
			dataType:'json'					
		}).done(function(data){
			$('#pr-dly-bltn-search-date').datepicker('option', 'maxDate', data.data.endDate);
			$('#pr-dly-bltn-search-date').datepicker('option', 'minDate', data.data.startDate);
$('#pr-dly-bltn-search-date').val(data.data.lastDate);
			$('#pr-dly-bltn-mark').sanDatasheet({
				url:data,
				dataSource: 'local',
				dataHandler: function(data){
					$('#pr-excel').attr("href",DQSURL + "cm-u-dlrp/PrDlyBltnExcel?lang=cn&searchDate="+searchDate+"&publishedTime="+PR_PUBLISHED_TIME);
					var d = data['data']['updateDate'];
					var $sheet = this;
					return _example_dataFormatter($sheet, d, data['records']);
				},
				mediaListening: true,
				onMediaChange: function(){
					// 通过滚动条滚动，并固定首列
					if (MEDIA_CASE != 'XL') {
						var sheetSet = getsheetWidthCase($('#pr-dly-bltn-mark'), setSheetWidth($('#pr-dly-bltn-mark'))),
							rw = sheetSet.width,
							strCol = sheetSet.colHtml;
						$('#pr-dly-bltn-mark').find('colgroup').html(strCol);
					} else {
						$('#pr-dly-bltn-mark').find('colgroup').empty();
					}
					return {
						'XL': {
							fixedLayout: false
						},
						'default': {
							fixedLayout: true,
							fixedLayoutType: 'column',
							fixedBodyWidth: rw,
							fixedColNumber: 1
						}
					}
				}
			});
		})	
}

function prTermList(searchDate){
	$.ajax({
		type: "POST",
		    async:false,
			url:BK_URL + 'cm-u-dlrp/PrDlyBltn',
			data:{
				lang : "en",
				indexType : "markInterBankVOList",
				searchDate : searchDate,
				publishedTime : PR_PUBLISHED_TIME
			},
			dataType:'json'					
		}).done(function(data){
			$('#pr-dly-bltn-search-date').datepicker('option', 'maxDate', data.data.endDate);
			$('#pr-dly-bltn-search-date').datepicker('option', 'minDate', data.data.startDate);
$('#pr-dly-bltn-search-date').val(data.data.lastDate);
			$('#pr-dly-bltn-term').sanDatasheet({
				url:data,
				dataSource: 'local',
				dataHandler: function(data){
					var $sheet = this;
					return _example_dataFormatter($sheet, '', data['records']);
				},
				mediaListening: true,
				onMediaChange: function(){
					// 通过滚动条滚动，并固定首列
					if (MEDIA_CASE != 'XL') {
						var sheetSet = getsheetWidthCase($('#pr-dly-bltn-term'), setSheetWidth($('#pr-dly-bltn-term'))),
							rw = sheetSet.width,
							strCol = sheetSet.colHtml;
						$('#pr-dly-bltn-term').find('colgroup').html(strCol);
					} else {
						$('#pr-dly-bltn-term').find('colgroup').empty();
					}
					return {
						'XL': {
							fixedLayout: false
						},
						'default': {
							fixedLayout: true,
							fixedLayoutType: 'column',
							fixedBodyWidth: rw,
							fixedColNumber: 1
						}
					}
				}
			});
		})	
}
function setSheetWidth($sheet) {
    var $tr = $sheet.find('thead:eq(0)>tr').children(),
        // 各列宽度
        w = [], _w;
    $tr.each(function(i){
        switch (i) {
            case 0:
                _w = 80;
                break;
            case 5:
                _w = 130;
                break;
            default:
                _w =120;
                break;
        }
        w.push(_w);
    });
    return w;
}
</script>
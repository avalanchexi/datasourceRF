      "excerpts": [
        {
          "start_line": 76,
          "end_line": 90,
          "lines": [
            "@dataclass(frozen=True)",
            "class ContextScalar:",
            "    metric_id: str",
            "    api_name: str",
            "    source_field: str",
            "    period_kind: str",
            "    period_start: str",
            "    period_end: str",
            "    dimensions: dict[str, str]",
            "    value: float",
            "    unit: str",
            "    release_at: datetime | None = None",
            "    public_available_at: datetime | None = None",
            "    definition_version: str | None = None",
            "    acquisition_ids: tuple[str, ...] = ()"
          ]
        },
        {
          "start_line": 567,
          "end_line": 599,
          "lines": [
            "    def treasury_yields(",
            "        self,",
            "        *,",
            "        start_date: date,",
            "        end_date: date,",
            "    ) -> tuple[ContextScalar, ...]:",
            "        if end_date < start_date:",
            "            raise ValueError(\"tushare_date_range_invalid\")",
            "        rows = self._call(",
            "            \"us_tycr\",",
            "            {",
            "                \"start_date\": start_date.strftime(\"%Y%m%d\"),",
            "                \"end_date\": end_date.strftime(\"%Y%m%d\"),",
            "            },",
            "            (\"date\", \"y2\", \"y10\"),",
            "        )",
            "        return tuple(",
            "            _daily_scalar(",
            "                metric_id,",
            "                \"us_tycr\",",
            "                source_field,",
            "                row,",
            "                date_field=\"date\",",
            "                dimensions={},",
            "                unit=\"percent\",",
            "            )",
            "            for row in rows",
            "            for metric_id, source_field in (",
            "                (\"UST2Y_NOMINAL_YIELD\", \"y2\"),",
            "                (\"UST10Y_NOMINAL_YIELD\", \"y10\"),",
            "            )",
            "            if _number(row.get(source_field)) is not None",
            "        )"
          ]
        },
        {
          "start_line": 1265,
          "end_line": 1322,
          "lines": [
            "        release_at: datetime | None",

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "report_cutoff",
    "current_stage",
    "one_line_conclusion",
    "sections",
    "transition_watches",
    "data_gaps",
    "used_evidence_ids",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "report.v1-prototype"},
    "bundle_id": {"type": "string", "const": "eb-prototype-v1"},
    "report_cutoff": {"type": "string", "const": "2026-08-19T18:00:00+08:00"},
    "current_stage": {"type": "string", "const": "Stage II"},
    "one_line_conclusion": {"type": "string", "minLength": 20},
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "conclusion", "evidence_ids", "governance_refs"],
        "properties": {
          "section_id": {
            "type": "string",
            "enum": [
              "formal_stage",
              "core_assets",
              "policy_and_credit",
              "inventory_and_overheat",
              "price_pressure",
              "data_quality"
            ]
          },
          "title": {"type": "string", "minLength": 2},
          "conclusion": {"type": "string", "minLength": 20},
          "evidence_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "enum": [
                "ev-bond-state",
                "ev-equity-state",
                "ev-commodity-state",
                "ev-commodity-watch",
                "ev-dr007",
                "ev-policy-rate",
                "ev-pmi-orders",
                "ev-pmi-inventory",
                "ev-ppi",
                "ev-core-cpi",
                "ev-brent"
              ]
            }
          },
          "governance_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "enum": ["gap-vix-source-certification"]
            }
          }
        }
      }
    },
    "transition_watches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "direction", "status", "conclusion", "evidence_ids"],
        "properties": {
          "asset": {"type": "string", "const": "commodity"},
          "direction": {"type": "string", "const": "bullish"},
          "status": {"type": "string", "const": "asset_candidate_only"},
          "conclusion": {"type": "string", "minLength": 20},
          "evidence_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "enum": ["ev-commodity-state", "ev-commodity-watch"]}
          }
        }
      }
    },
    "data_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "metric_id", "status", "impact", "proxy_used"],
        "properties": {
          "gap_id": {"type": "string", "const": "gap-vix-source-certification"},
          "metric_id": {"type": "string", "const": "CBOE_VIX_INDEX"},
          "status": {"type": "string", "const": "awaiting_source_certification"},
          "impact": {"type": "string", "const": "international_context_only"},
          "proxy_used": {"type": "boolean", "const": false}
        }
      }
    },
    "used_evidence_ids": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "ev-bond-state",
          "ev-equity-state",
          "ev-commodity-state",
          "ev-commodity-watch",
          "ev-dr007",
          "ev-policy-rate",
          "ev-pmi-orders",
          "ev-pmi-inventory",
          "ev-ppi",
          "ev-core-cpi",
          "ev-brent"
        ]
      }
    },
    "disclaimer": {"type": "string", "minLength": 12}
  }
}
